<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>SpiderMan2</AssemblyName>
        <RootNamespace>SpiderMan2</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <TieredPGO>true</TieredPGO>
        <!-- the recompiled output is one huge partial class; keep the compiler happy -->
        <NoWarn>$(NoWarn);CS0164;CS0219;CS0162;CS8321</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <Import Project="../../tools/RecompOne/GamePort.props" />

    <ItemGroup>
        <ProjectReference Include="..\..\tools\RecompOne\RecompOne.Runtime\RecompOne.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\generated\**\*.cs" />
        <Compile Include="..\patches\**\*.cs" />
        <!-- Projection/HUD policy is engine-shared; only the measured swap address differs. -->
        <Compile Include="..\..\spiderman\patches\Wide.cs" Link="Shared\Wide.cs" />
        <Compile Include="..\..\spiderman\patches\WorldFrustum.cs" Link="Shared\WorldFrustum.cs" />
        <Compile Include="..\..\spiderman\patches\WorldSubpixel.cs" Link="Shared\WorldSubpixel.cs" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Symbol names for stall dumps (see patches/Diag.cs), embedded rather than
          copied beside the executable.
        -->
        <EmbeddedResource Include="..\config\funcmaps\*.json" Exclude="..\config\funcmaps\*_sweep.json">
            <LogicalName>funcmaps.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <!-- Deterministic ship payload; materialized beside the executable on first run. -->
        <EmbeddedResource Include="bundled\runtime-assets.zip">
            <LogicalName>OpenSpidey.BundledAssets.zip</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
