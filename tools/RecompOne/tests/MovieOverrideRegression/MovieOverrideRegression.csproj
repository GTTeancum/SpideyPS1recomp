<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Actual shipping readers and orchestration; only host devices are fixtures. -->
    <Compile Include="../../RecompOne.Runtime/Media/*.cs" Link="Media/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../movies/test-fixtures/tiny.sfd" Link="tiny.sfd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../movies/native/bin/libOpenSpideySfd.so" Link="libOpenSpideySfd.so" CopyToOutputDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <Content Include="../../../movies/native/bin/OpenSpideySfd.dll" Link="OpenSpideySfd.dll" CopyToOutputDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
</Project>
